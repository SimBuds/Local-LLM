#!/usr/bin/env bash
set -euo pipefail

MODEL_NAME="neoqwen"
# Added 2026-09-16 by ./add-model.
BASE_MODEL="Qwen3.8-27B-TurboFCFusion-735-882-Here-Uncen-NEO-CODER-MAX-MTP-Q4_K_M.gguf"

# Per-model load params. PARAMS is the shared sampler baseline and lives in
# build-common.sh, identical for every model, so it is deliberately absent here.
# This GGUF carries MTP heads (nextn_predict_layers), so speculative decoding
# is on. Keep spec-type when re-deriving n-cpu-moe: the MTP layer needs VRAM
# of its own, and fitting without it gives a split that is too generous.
#
# Split pinned from --fit-target 2048 on 2026-09-16, with
# 1310 MiB held by other processes at probe time.
# Fit line: CUDA0 (NVIDIA GeForce RTX 3080):  9 layers,   5626 MiB used,   2173 MiB free
# dense model: the fitter kept 9 of 66 layers on the GPU rather than offloading experts.
# server.ini pins fit = off, so this is the split every load uses. Re-derive it
# with ./add-model on a fresh builder, or the recipe in README.md, after a
# model or hardware change. Do not turn automatic fitting back on: it would
# resize the split from whatever VRAM happens to be free per run.
LOAD=(
  'n-gpu-layers = 9'
  'spec-type = draft-mtp'
)

# Shared assembly, see build-common.sh.
source "$(dirname "${BASH_SOURCE[0]}")/build-common.sh"
