# systemd user unit: the shared llama.cpp router server on http://localhost:8080.
#
# Independent of any repo at runtime. It reads only the deployed preset in
# ~/.config/llama.cpp/models.ini (written by `make deploy` in ~/Apps/Local-LLM)
# and the GGUFs that preset names. Installed by copying this file, not symlinking,
# into ~/.config/systemd/user/. See README.md, "Serving other apps".
#
# %h is the user's home directory. The binary path is absolute because user units
# do not inherit the login shell's PATH.
#
# --cors-origins localhost: the default (*) let any web page read the router's
# responses. Since llama.cpp 1.0 (build 12439) only same-origin requests are
# allowed, and any other Origin gets a 403. The host apps send no Origin, so
# they are unaffected (checked 2026-11-16). A Host header that is not localhost
# also gets the 403, so a QEMU guest calling 10.0.2.2:8080 is refused and uses
# an SSH reverse tunnel instead (found 2026-11-21, README, Use With Pi).

[Unit]
Description=llama.cpp router server (http://localhost:8080)
Documentation=https://github.com/ggml-org/llama.cpp/tree/master/tools/server

[Service]
Type=simple
ExecStart=%h/.local/bin/llama-server --models-preset %h/.config/llama.cpp/models.ini --models-max 1 --port 8080 --cors-origins localhost
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
