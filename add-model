#!/usr/bin/env python3
"""
Scaffold a build-* script for a GGUF that is already staged in $GGUF_DIR.

  ./add-model                  pick from the staged GGUFs no builder claims
  ./add-model FILENAME.gguf    skip the menu
  ./add-model ORG/REPO         list a HuggingFace repo's GGUFs and print the
                               download command for the one you pick
  ./add-model --no-probe ...   scaffold only, do not touch the GPU
  ./add-model --refit NAME...  re-derive an existing model's split and report it
                               beside the pinned value. Writes nothing.

It writes build-<name> and derives the GPU/CPU split by loading the model once
with llama.cpp's fitter. Downloading the GGUF is yours.

Why this exists rather than "copy build-lite and edit three lines": the router
name and the MTP flag are the two fields that are silently wrong when hand
edited. A wrong name yields a preset section no client can address, and a wrong
spec-type makes the fit probe size the card for a different model.
"""

# Stdlib only, like scripts/llm and scripts/verify-build. It was bash with a
# Python heredoc and jq until 2026-11-11, and shares the busy-router check, the
# port search and the process stop with verify-build through scripts/_probe.py.

from __future__ import annotations

import datetime
import json
import os
import re
import struct
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

AI_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(AI_ROOT / "scripts"))
from _probe import (RouterUnreadable, free_port, read_defaults,  # noqa: E402
                    read_preset, service_busy, stop)

GGUF_DIR = Path(os.environ.get("GGUF_DIR") or Path.home() / "models/gguf")

# Names other repos address the router by. Reusing one would point an existing
# app at a different model without that app changing, so they are refused here
# rather than left to review. README.md, "Serving other apps", is the contract.
CONTRACT_NAMES = ("gemma", "qwen", "lite", "freedom")

# Overridable so tests can point at a fake, and so a mirror can be used.
HF_API = os.environ.get("HF_API", "https://huggingface.co/api/models")
HF_HOST = os.environ.get("HF_HOST", "https://huggingface.co")

# The live router, read so the probe never runs beside a model it holds.
LLM_URL = os.environ.get("LLM_URL", "http://localhost:8080")

# Seconds to wait for the server to report. A 21 GB model off a cold page cache
# takes far longer than a warm 5 GB one, so this is generous and only exists so a
# wedged probe fails instead of hanging.
FIT_TIMEOUT = int(os.environ.get("FIT_TIMEOUT", "300"))


def die(msg: str) -> None:
    sys.exit(f"ERROR: {msg}")


def ask(prompt: str) -> str | None:
    """One line from stdin after `prompt`, stripped, or None at end of input."""
    sys.stdout.write(prompt)
    sys.stdout.flush()
    line = sys.stdin.readline()
    return line.strip() if line else None


def pick_number(count: int) -> int:
    """A 0-based index chosen from a menu of `count` items."""
    while True:
        choice = ask("Pick a number: ")
        if choice is None:
            die("no choice given")
        if choice.isdigit() and 1 <= int(choice) <= count:
            return int(choice) - 1
        print(f"  not one of 1 to {count}")


def today() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")


# --- reading the GGUF -------------------------------------------------------

# GGUF scalar value types by id, from the format spec. 8 is a string, 9 an array.
SIMPLE = {0: "<B", 1: "<b", 2: "<H", 3: "<h", 4: "<I", 5: "<i", 6: "<f", 7: "<?",
          10: "<Q", 11: "<q", 12: "<d"}


def has_mtp(path: Path) -> bool | None:
    """True when the GGUF carries multi-token-prediction heads, which llama.cpp
    drives with `--spec-type draft-mtp`. None when it cannot be read.

    The marker is a `<arch>.nextn_predict_layers` metadata key, checked
    2026-09-15 against the four staged GGUFs: both Qwen MTP builds carry it,
    gemma4-26b and granite4.2 do not. Do not be tempted to grep the file for
    "mtp": gemma4-26b contains 4 such byte sequences and granite 9.
    """
    def read(f, fmt):
        return struct.unpack(fmt, f.read(struct.calcsize(fmt)))[0]

    def string(f):
        return f.read(read(f, "<Q")).decode("utf-8", "replace")

    def value(f, t):
        if t in SIMPLE:
            return read(f, SIMPLE[t])
        if t == 8:
            return string(f)
        if t == 9:
            et, n = read(f, "<I"), read(f, "<Q")
            return [value(f, et) for _ in range(n)]
        raise ValueError(f"unknown GGUF value type {t}")

    try:
        with open(path, "rb") as f:
            if f.read(4) != b"GGUF":
                return None
            read(f, "<I"), read(f, "<Q")           # version, tensor count
            for _ in range(read(f, "<Q")):         # metadata key/value pairs
                key = string(f)
                val = value(f, read(f, "<I"))
                if (key.endswith(".nextn_predict_layers") and isinstance(val, int)
                        and not isinstance(val, bool) and val > 0):
                    return True
    except (OSError, struct.error, ValueError, IndexError):
        return None
    return False


# --- looking up a HuggingFace repo ------------------------------------------

def looks_like_repo(arg: str) -> bool:
    """A URL or anything with a slash. A staged GGUF is always a bare filename in
    $GGUF_DIR, so the two never collide."""
    return arg.startswith(("http://", "https://")) or "/" in arg


def repo_slug(arg: str) -> str:
    """"https://huggingface.co/Org/Repo?clone=true" and "Org/Repo" both give "Org/Repo"."""
    s = arg.split("?", 1)[0]
    for prefix in ("http://", "https://", "huggingface.co/"):
        s = s.removeprefix(prefix)
    s = s.removesuffix("/")
    return s.removesuffix("/tree/main")


def hf_pick(arg: str) -> str:
    """List the repo's GGUFs, let the user choose, and print the download command.
    Returns the filename to look for in $GGUF_DIR (the first shard of a set).

    It prints rather than downloads: the target is $GGUF_DIR, which lives outside
    the repo, so the transfer is the human's to run and to interrupt.
    """
    slug = repo_slug(arg)
    try:
        with urllib.request.urlopen(f"{HF_API}/{slug}/tree/main", timeout=30) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            # HuggingFace answers a repo that does not exist with 401, the same as
            # a gated one (seen 2026-10-09), so the message names both causes.
            die(f"{slug} was not found, or is gated or private (HTTP {e.code}).\n"
                f"  Check the spelling at https://huggingface.co/{slug}. If it is right, accept the\n"
                f"  model's terms on that page while signed in, then retry.")
        if e.code == 404:
            die(f"no such model repo: {slug} (HTTP 404)")
        die(f"HuggingFace returned HTTP {e.code} for {slug}")
    except (urllib.error.URLError, OSError):
        die(f"could not reach {HF_API} (no network, or the request timed out)")
    try:
        entries = json.loads(raw.decode("utf-8"))
        files = [e for e in entries if e.get("type") == "file"
                 and str(e.get("path", "")).endswith(".gguf")]
    except (ValueError, AttributeError, TypeError):
        die(f"HuggingFace returned a listing for {slug} that is not JSON")

    # One row per model: sharded sets (NAME-00001-of-00003.gguf) collapse to one
    # entry carrying every shard, because they are downloaded and loaded together.
    groups: dict[str, list[dict]] = {}
    for e in files:
        base = re.sub(r"-[0-9]{5}-of-[0-9]{5}\.gguf$", ".gguf", e["path"])
        groups.setdefault(base, []).append(e)
    rows = sorted(({"name": base,
                    "size": sum(e.get("size", 0) for e in shards),
                    "shards": sorted(shards, key=lambda e: e["path"])}
                   for base, shards in sorted(groups.items())),
                  key=lambda r: r["size"])
    if not rows:
        die(f"no GGUF files in {slug}")
    projectors = [r["name"] for r in rows if "mmproj" in r["name"]]
    models = [r for r in rows if "mmproj" not in r["name"]]
    if not models:
        die(f"no GGUF files in {slug} (only projectors)")

    print(f"GGUF files in {slug}:")
    for i, r in enumerate(models, 1):
        label = f"  [{len(r['shards'])} shards]" if len(r["shards"]) > 1 else ""
        print(f"  {i}) {r['name']:<52} {r['size'] / 1e9:6.1f} GB{label}")
    if projectors:
        print("  (vision projector in this repo, download alongside if you need vision:"
              + "".join(f" {p}" for p in projectors) + ")")

    pick = models[pick_number(len(models))]
    print()
    print("Download it yourself, then re-run add-model. Resumable, safe to repeat:")
    print()
    # Set before use: a shell without GGUF_DIR would otherwise expand the target to
    # /<file>. That happened on the 2026-09-16 neoqwen download.
    print('  GGUF_DIR="${GGUF_DIR:-$HOME/models/gguf}"')
    for e in pick["shards"]:
        print(f'  curl -L --fail -C - -o "$GGUF_DIR/{e["path"]}" \\')
        print(f'    "{HF_HOST}/{slug}/resolve/main/{e["path"]}"')
    print()
    # HuggingFace stores an LFS object's sha256 as its oid, so the expected value
    # is already in the listing. `sha256sum -c` exits non-zero on a mismatch, which
    # is the check a human skips when asked to compare 64 hex characters by eye.
    print("Then verify it against HuggingFace's checksum. Each line must print OK:")
    for e in pick["shards"]:
        oid = (e.get("lfs") or {}).get("oid", "")
        if oid:
            print(f'  echo "{oid}  $GGUF_DIR/{e["path"]}" | sha256sum -c -')
        else:
            print(f"  (no checksum published for {e['path']}, so it cannot be verified)")
    print()
    print("--fail matters: without it a 404 or a gated redirect is saved as a valid")
    print("looking .gguf full of HTML, and you find out at load time.")

    return pick["shards"][0]["path"] if len(pick["shards"]) > 1 else pick["name"]


# --- probing the fit --------------------------------------------------------

def refuse_if_router_busy() -> None:
    """Refuse to probe while the router has a model loaded or loading. The fitter
    sizes the split from free VRAM, so a resident model would shrink it and the
    pinned value would starve every later load. A sleeping or unloaded model frees
    its VRAM (6226 down to 242 MiB, measured 2026-09-15), so the always-on service
    alone is no reason to stop."""
    try:
        busy = service_busy(LLM_URL)
    except RouterUnreadable as e:
        die(str(e))
    if busy is None:
        print(f"No router answering at {LLM_URL}, so none holds VRAM.")
    elif busy:
        die(f"the router at {LLM_URL} holds {' '.join(busy)} in VRAM, which would shrink "
            f"the probed split.\n"
            f"  Free it first:  llm unload\n"
            f"  (A sleeping model is fine, it has already released its VRAM.)")


# Shared settings that change what a load costs in VRAM, as the probe flags that
# carry them. Read from server.ini rather than written out here: until
# 2026-11-11 the cache types and flash attention were literals, so a preset
# change to either would have sized the split for a cache the router does not
# build. `fit` and `n-gpu-layers` are left out on purpose: they pin the split
# for serving, and passing them would stop the fitter choosing one.
PROBE_FLAGS = (("ctx-size", "-c"), ("ubatch-size", "-ub"), ("cache-type-k", "-ctk"),
               ("cache-type-v", "-ctv"), ("flash-attn", "-fa"))


class Fit:
    """What the probe decided: the LOAD key to pin (empty for a full fit), its
    value, the fitter's final report line, and a note for a dense model."""

    def __init__(self, key: str = "", n: str = "", line: str = "", note: str = ""):
        self.key, self.n, self.line, self.note = key, n, line, note


def shared_settings() -> dict[str, str]:
    """server.ini's [*] section, which a new model will be served with.

    The compute buffer grows with the physical batch, so the probe must use the
    one the router serves at. Until 2026-10-09 it passed none, and every split it
    derived after server.ini moved to 1024 was sized for llama.cpp's default 512.
    The context is read the same way, so the probe cannot drift from the served
    one (it was hardcoded until 2026-10-31).
    """
    ini = AI_ROOT / "server.ini"
    if not ini.is_file():
        die(f"no server.ini at {ini}. The probe needs its ubatch-size and ctx-size to size "
            f"the split the router will serve.")
    settings = read_defaults(ini)
    if not settings.get("ctx-size"):
        die(f"no ctx-size in {ini}. The probe sizes the KV cache from it, so it will not guess.")
    return settings


def probe_fit(gguf: Path, settings: dict[str, str]) -> Fit:
    """Load the model once with llama.cpp's fitter and read what it pushed off the GPU.

    `settings` are what the router serves the model with: server.ini's [*] for a
    new model, its merged preset section for a refit. Only PROBE_FLAGS and
    spec-type are taken from them, so a pinned split never reaches the fitter.

    The log goes to a file because llama-server buffers a pipe: README.md
    records losing the fit line twice by stopping a piped probe as soon as it
    answered. And the loop waits for the offload line OR for the server to come
    up, because a model that fits entirely never prints an overflow line at all
    (`lite` loads with "offloaded 34/34 layers to GPU" and no fit line, measured
    2026-09-15).
    """
    # Unlike the batch the context is required: llama-server's default is the
    # trained context, 262144 for this lineup, which sizes the split for a KV
    # cache twice the one the router serves. Callers check it, this is the guard.
    ctx, ub, spec = settings["ctx-size"], settings.get("ubatch-size"), settings.get("spec-type")

    cmd = ["llama-server", "-m", str(gguf), "-np", "1", "--no-mmproj", "--fit-target", "2048",
           "--port", str(free_port()), "-lv", "4"]
    for key, flag in PROBE_FLAGS:
        if settings.get(key):
            cmd += [flag, settings[key]]
    # Keep spec-type: the MTP layer needs VRAM of its own, and fitting without it
    # gives a split that is too generous.
    if spec:
        cmd += ["--spec-type", spec]

    print(f"Probing the GPU/CPU split (--fit-target 2048, -c {ctx}"
          f"{f', -ub {ub}' if ub else ''}"
          f"{', MTP on' if spec == 'draft-mtp' else f', spec-type {spec}' if spec else ''}).")
    print("  Loading the model once. Close anything holding VRAM: the split is sized")
    print("  from what is free right now, and that is why it gets pinned.")
    sys.stdout.flush()

    fd, log_name = tempfile.mkstemp(prefix="add-model-fit-", suffix=".log")
    log = Path(log_name)
    offload_re = re.compile(r"offloaded ([0-9]+)/([0-9]+) layers to GPU")
    with os.fdopen(fd, "w") as out:
        try:
            proc = subprocess.Popen(cmd, stdout=out, stderr=subprocess.STDOUT)
        except OSError as e:
            die(f"could not start llama-server ({e}). Is it on PATH?")
    try:
        # Wait for `offloaded X/Y layers to GPU`, which every load prints however
        # the fitter decided, rather than for the overflow line, which only the
        # MoE path prints. `model loaded` is the backstop for a build that prints
        # neither.
        deadline = time.monotonic() + FIT_TIMEOUT
        while True:
            seen = log.read_text(encoding="utf-8", errors="replace")
            if offload_re.search(seen) or "model loaded" in seen:
                break
            if proc.poll() is not None:
                die(f"the fit probe exited before reporting a split. Read the log: {log}")
            if time.monotonic() >= deadline:
                die(f"the fit probe timed out after {FIT_TIMEOUT}s. Read the log: {log}")
            time.sleep(1)
    finally:
        stop(proc)

    lines = log.read_text(encoding="utf-8", errors="replace").splitlines()
    offload = next((m for m in map(offload_re.search, lines) if m), None)
    if offload is None:
        die(f"the probe never reported how many layers it offloaded. Read the log: {log}")
    on, total = offload.groups()

    # The last report is the decision. The fitter prints intermediate stages first
    # that match the same pattern: a 64k gemma load reports `31 layers, 2861 MiB
    # used, 5586 MiB free` before `31 layers (22 overflowing), 6272 MiB used,
    # 2175 MiB free`, and recording the first one misstated the margin by 3.4 GB.
    reports = [ln for ln in lines if re.search(r"CUDA[0-9]+ .*MiB used", ln)]
    fit_line = reports[-1][reports[-1].rfind("CUDA"):] if reports else ""
    overflow = next((m.group(1) for m in
                     (re.search(r".*[^0-9]([0-9]+) overflowing", ln) for ln in lines) if m), None)
    log.unlink()

    # Three outcomes, not two. Until 2026-09-16 this read only the MoE wording and
    # treated its absence as a perfect fit, which wrote a dense 18.5 GB model out
    # with no split and would have failed at load under `fit = off`.
    #
    #   overflow clause present  MoE: experts go to the CPU, pin n-cpu-moe = M
    #   offloaded X/Y, X below Y dense: the fitter cut GPU layers, pin n-gpu-layers = X
    #   offloaded Y/Y, no overflow everything on the GPU, nothing to pin
    #
    # The overflow check must come first. MoE spills experts, not layers, so a
    # spilling MoE model still reports every layer on the GPU: gemma4-26b prints
    # `offloaded 31/31 layers to GPU` beside `31 layers (20 overflowing)`.
    if overflow:
        return Fit("n-cpu-moe", overflow, fit_line)
    if on == total:
        return Fit(line=fit_line)
    return Fit("n-gpu-layers", on, fit_line,
               f"dense model: the fitter kept {on} of {total} layers on the GPU rather "
               f"than offloading experts")


# --- choosing the GGUF ------------------------------------------------------

def builders() -> list[Path]:
    return sorted(AI_ROOT.glob("build-*"))


def claimed_by(gguf: str) -> list[str]:
    """Builders whose BASE_MODEL line names `gguf`."""
    line = re.compile(r'^BASE_MODEL="(.*)"[ \t]*$', re.MULTILINE)
    return [b.name for b in builders()
            if gguf in line.findall(b.read_text(encoding="utf-8", errors="replace"))]


def candidates() -> list[str]:
    """Staged GGUFs no builder claims. *.mmproj.gguf are vision projectors loaded
    alongside a model, never a model themselves, so they are not offered."""
    return sorted(p.name for p in GGUF_DIR.glob("*.gguf")
                  if p.is_file() and not p.name.endswith(".mmproj.gguf")
                  and not claimed_by(p.name))


def pick_gguf() -> str:
    options = candidates()
    if not options:
        die(f"no unclaimed GGUF in {GGUF_DIR} (every staged file already has a builder)")
    print("Staged GGUFs without a builder:", file=sys.stderr)
    for i, f in enumerate(options, 1):
        print(f"  {i}) {f}  ({(GGUF_DIR / f).stat().st_size / 1e9:.1f} GB)")
    return options[pick_number(len(options))]


# --- choosing the router name -----------------------------------------------

def read_name() -> str:
    while True:
        name = ask("Router name: ")
        if name is None:
            die("no name given")
        if not re.fullmatch(r"[a-z][a-z0-9]*", name):
            print(f"  '{name}' is not usable: lower-case letter first, then letters and digits.")
            print("  It becomes the [section] in models.ini and the model field clients send.")
        elif name in CONTRACT_NAMES:
            print(f"  '{name}' is part of the router contract other repos depend on.")
            print("  Reusing it would repoint their requests at a different model.")
        elif (AI_ROOT / f"build-{name}").exists():
            print(f"  build-{name} already exists. Pick another name, or edit that file.")
        else:
            return name


# --- writing the builder ----------------------------------------------------

def gpu_used() -> str:
    try:
        out = subprocess.run(["nvidia-smi", "--query-gpu=memory.used",
                              "--format=csv,noheader"],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else "unknown"


def builder_text(name: str, gguf: str, mtp: bool, fit: Fit, probed: bool) -> str:
    out = ["#!/usr/bin/env bash", "set -euo pipefail", "",
           f'MODEL_NAME="{name}"',
           f"# Added {today()} by ./add-model.",
           f'BASE_MODEL="{gguf}"', "",
           "# Per-model load params. The shared sampler baseline lives in server.ini [*],",
           "# identical for every model, so PARAMS is deliberately absent here."]
    if mtp:
        out += ["# This GGUF carries MTP heads (nextn_predict_layers), so speculative decoding",
                "# is on. Keep spec-type when re-deriving n-cpu-moe: the MTP layer needs VRAM",
                "# of its own, and fitting without it gives a split that is too generous."]
    out.append("#")
    if fit.n:
        out += [f"# Split pinned from --fit-target 2048 on {today()}, with",
                f"# {gpu_used()} held by other processes at probe time.",
                f"# Fit line: {fit.line}"]
        if fit.note:
            out.append(f"# {fit.note}.")
        out += ["# server.ini pins fit = off, so this is the split every load uses. Re-derive it",
                f"# with ./add-model --refit {name} after a model or hardware change. Do not",
                "# turn automatic fitting back on: it would resize the split from whatever",
                "# VRAM happens to be free per run."]
    elif probed:
        out += [f"# Probed on {today()} with --fit-target 2048: this model fits",
                "# entirely on the card, so there is no expert split to pin."]
    else:
        out += ["# n-cpu-moe is NOT set: --no-probe was used. server.ini pins fit = off, so",
                "# until you add one this model is loaded entirely onto the GPU. Derive it",
                f"# with ./add-model --refit {name} after make build, then add:",
                "#   'n-cpu-moe = N'"]
    out.append("LOAD=(")
    if fit.n:
        out.append(f"  '{fit.key} = {fit.n}'")
    if mtp:
        out.append("  'spec-type = draft-mtp'")
    out += [")", "",
            "# Shared assembly, see build-common.sh.",
            'source "$(dirname "${BASH_SOURCE[0]}")/build-common.sh"']
    return "\n".join(out) + "\n"


def write_builder(name: str, text: str) -> None:
    out = AI_ROOT / f"build-{name}"
    try:
        with open(out, "x", encoding="utf-8") as f:
            f.write(text)
    except FileExistsError:
        die(f"build-{name} appeared while you were typing, refusing to overwrite")
    out.chmod(0o755)


# --- re-deriving an existing split -----------------------------------------

def refit_settings(names: list[str]) -> dict[str, dict[str, str]]:
    """Each named model's merged settings from the built preset, refusing any the
    preset does not hold or holds from an older builder."""
    preset = AI_ROOT / "models" / "models.ini"
    if not preset.is_file():
        die(f"no built preset at {preset}. Run make build first: refit reads each "
            f"model's settings from it.")
    models = read_preset(preset)
    unknown = [n for n in names if n not in models]
    if unknown:
        die(f"not in {preset}: {' '.join(unknown)}. Models there: "
            f"{' '.join(sorted(models)) or '(none)'}")
    built_at = preset.stat().st_mtime
    for n in names:
        stamp = AI_ROOT / "models" / n / ".built"
        sources = [AI_ROOT / "server.ini", AI_ROOT / f"build-{n}"]
        newer = [s.name for s in sources
                 if s.exists() and s.stat().st_mtime > min(
                     built_at, stamp.stat().st_mtime if stamp.exists() else 0)]
        if newer or not stamp.exists():
            die(f"{n}: {' and '.join(newer) or 'its build stamp'} changed since the last "
                f"make build, so the preset may not say what the builder says. Run make "
                f"build, then refit.")
    return {n: models[n] for n in names}


def pinned(settings: dict[str, str], defaults: dict[str, str]) -> tuple[str, str]:
    """The split a model's section pins: n-cpu-moe, or an n-gpu-layers that
    differs from [*]'s all-on-GPU value, or nothing."""
    if settings.get("n-cpu-moe"):
        return "n-cpu-moe", settings["n-cpu-moe"]
    if settings.get("n-gpu-layers") and settings["n-gpu-layers"] != defaults.get("n-gpu-layers"):
        return "n-gpu-layers", settings["n-gpu-layers"]
    return "", ""


def refit(names: list[str]) -> int:
    """Probe each named model as the router serves it and report the split the
    fitter picks beside the pinned one. Writes nothing: pinned splits are locked
    (AGENTS.md), so acting on a changed value stays a human edit."""
    if not names:
        die("--refit needs at least one model name, e.g. ./add-model --refit gemma")
    models = refit_settings(names)
    defaults = read_defaults(AI_ROOT / "models" / "models.ini")
    refuse_if_router_busy()
    for n, settings in models.items():
        if not settings.get("ctx-size"):
            die(f"{n}: no ctx-size in the built preset. The probe sizes the KV cache from it.")
        print()
        print(f"--- {n}")
        fit = probe_fit(Path(settings["model"]), settings)
        was = pinned(settings, defaults)
        was_s = f"{was[0]} = {was[1]}" if was[0] else "none (all on the GPU)"
        now_s = f"{fit.key} = {fit.n}" if fit.key else "none (it fits entirely on the card)"
        print(f"{n}: pinned {was_s}, the fitter now picks {now_s}.")
        if fit.line:
            print(f"  Fit line: {fit.line}")
        if (fit.key, fit.n) == was:
            print("  Unchanged.")
        else:
            print(f"  Changed. Pinned splits are locked: changing build-{n} needs approval and "
                  f"a spike test (AGENTS.md, project rules).")
    return 0


# --- main -------------------------------------------------------------------

def main(argv: list[str]) -> int:
    probe, refitting = True, False
    positional = []
    for arg in argv:
        if arg == "--no-probe":
            probe = False
        elif arg == "--refit":
            refitting = True
        elif arg in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif arg.startswith("-"):
            die(f"unknown option: {arg}")
        else:
            positional.append(arg)

    if refitting:
        if not probe:
            die("--refit probes by definition, so it cannot be combined with --no-probe")
        return refit(positional)

    if not GGUF_DIR.is_dir():
        die(f"GGUF_DIR does not exist: {GGUF_DIR}")

    if positional and looks_like_repo(positional[0]):
        target = hf_pick(positional[0])
        if not (GGUF_DIR / target).is_file():
            return 0
        print()
        print(f"{target} is already staged, carrying on.")
        gguf = target
    elif positional:
        gguf = positional[0]
        if not (GGUF_DIR / gguf).is_file():
            die(f"no such GGUF: {GGUF_DIR / gguf}")
    else:
        gguf = pick_gguf()

    # The menu hides claimed files, and a file named outright, or reached through
    # ORG/REPO, gets the same rule. A second builder on one GGUF serves the same
    # weights under two router names with two pinned splits.
    owners = claimed_by(gguf)
    if owners:
        die(f"{gguf} already has a builder: {' '.join(owners)}. Edit that file instead of "
            f"adding a second one.")

    # Before the name prompt, so a busy router is reported before anything is typed.
    if probe:
        refuse_if_router_busy()

    name = read_name()

    # Unreadable is the only reason to stop: guessing either way writes a builder
    # that is wrong in a way nothing else catches.
    mtp = has_mtp(GGUF_DIR / gguf)
    if mtp is None:
        die(f"could not read GGUF metadata from {GGUF_DIR / gguf} (not a GGUF, or truncated)")

    # Probe before writing: a failed probe must not leave a half-written builder
    # behind for someone to find later and assume was measured.
    settings = {**shared_settings(), **({'spec-type': 'draft-mtp'} if mtp else {})}
    fit = probe_fit(GGUF_DIR / gguf, settings) if probe else Fit()

    write_builder(name, builder_text(name, gguf, mtp, fit, probe))

    print()
    print(f"Wrote build-{name}")
    print(f"  base:      {gguf}")
    print(f"  MTP:       {'yes (spec-type = draft-mtp)' if mtp else 'no'}")
    print("  samplers:  shared baseline from server.ini [*]")
    if fit.n:
        print(f"  split:     {fit.key} = {fit.n}  ({fit.line})")
        print()
        print("Then: make build")
    elif probe:
        print("  split:     none needed, it fits entirely on the card")
        print()
        print("Then: make build")
    else:
        print("  split:     not probed (--no-probe)")
        print()
        print("Before serving it, derive the GPU/CPU split and add 'n-cpu-moe = N' to LOAD.")
        print("server.ini sets fit = off, so without it llama.cpp puts the whole model on the")
        print("card and a model larger than VRAM fails to load. Run make build, then")
        print(f"./add-model --refit {name} reports the split to pin.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
