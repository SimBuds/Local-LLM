#!/usr/bin/env bash
set -euo pipefail

MODEL_NAME="gemma"
# Reused from Ollama's gemma4:26b-a4b-it-qat blob (Q4_0 QAT) — same weights as the
# Ollama-era benchmarks, so post-switch deltas measure the runtime, not the model.
BASE_MODEL="gemma4-26b-a4b-it-qat.gguf"

# Per-model load params. The expert split is pinned rather than left to --fit,
# which sizes it from whatever VRAM is free at load time — so an open browser
# would change the offload between benchmark runs. 21 is what --fit chose with
# --fit-target 2048 on 2026-09-14 at ~1.2 GB desktop VRAM (31 layers, 21
# overflowing, 6184 MiB). The earlier 18 (fit at the default 1024 MiB margin)
# crashed with CUDA out of memory once desktop use plus a spike passed ~2.4 GB;
# 21 was spike-tested at ~3.0 GB. No MTP head in this GGUF, so no spec-type.
LOAD=(
  'n-cpu-moe = 21'
)

# Shared assembly — see build-common.sh.
source "$(dirname "${BASH_SOURCE[0]}")/build-common.sh"
