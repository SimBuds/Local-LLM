#!/usr/bin/env python3
"""
verify-build: check a candidate llama.cpp build against this repo's preset
before it goes live.

  scripts/verify-build [BINARY] [--live BINARY] [--out-root DIR] [--preset models/models.ini]

BINARY defaults to ~/src/llama.cpp/build-next/bin/llama-server, which is where
`scripts/llama-update build` leaves a new build. Nothing here touches the live
service: it refuses to start while the service has a model loaded, probes on
spare ports, and stops everything it started. Three checks, all must pass:

  1. Footprint. Each model is loaded at its pinned split (fit off, its own
     batch, cache types and load mode) with the LIVE build, then with the
     candidate, back to back, and nvidia-smi reads what each process holds. The
     candidate fails if it needs more than TOLERANCE_MIB extra. Comparing the two
     builds in one run cancels out whatever the desktop is holding: an absolute
     fit probe was tried first and failed both builds alike on 2026-09-25,
     because desktop apps held about 500 MiB more than when the pins were set.
  2. Smoke. A scratch router on 8081 runs the repo's preset with the candidate
     binary, and `run-profile.py smoke` runs against it with --out-root, so no
     result lands in eval/runs/ (which the README leaderboard is built from).
  3. GPU faults. The kernel's Xid count must not rise during the run.

Standalone like scripts/llm: stdlib only, no imports from eval/.
"""

from __future__ import annotations

import argparse
import configparser
import json
import os
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DEFAULT_BIN = Path.home() / "src/llama.cpp/build-next/bin/llama-server"
DEFAULT_LIVE = Path.home() / "src/llama.cpp/build/bin/llama-server"
# Extra VRAM a new build may need at the same split before the 2 GB margin is at
# risk. A same-binary noise-floor run measures how much two loads differ.
TOLERANCE_MIB = 100
LOAD_TIMEOUT_S = 240
ROUTER_TIMEOUT_S = 60


# --- pure parts (unit-tested) -------------------------------------------------

def read_preset(path: Path) -> dict[str, dict[str, str]]:
    """Each model's settings from a built models.ini: `[*]` defaults, then its section."""
    text = Path(path).read_text(encoding="utf-8")
    cp = configparser.ConfigParser(interpolation=None, comment_prefixes=(";", "#"),
                                   default_section="__none__")
    cp.optionxform = str  # keep keys exactly as llama-server spells them
    cp.read_string("[__top__]\n" + text)
    base = dict(cp["*"]) if cp.has_section("*") else {}
    return {name: {**base, **dict(cp[name])} for name in cp.sections()
            if name not in ("*", "__top__")}


def footprint_cmd(binary: str, settings: dict[str, str], port: int) -> list[str]:
    """One model at exactly the split the preset pins, as the router would load it."""
    cmd = [binary, "-m", settings["model"], "-np", "1", "--fit", "off", "-ngl", "99",
           "--port", str(port), "--no-mmproj"]
    for key, flag in (("n-cpu-moe", "--n-cpu-moe"), ("ctx-size", "--ctx-size"),
                      ("ubatch-size", "-ub"), ("cache-type-k", "-ctk"),
                      ("cache-type-v", "-ctv"), ("flash-attn", "-fa"),
                      ("load-mode", "--load-mode"), ("spec-type", "--spec-type")):
        if settings.get(key):
            cmd += [flag, settings[key]]
    return cmd


def process_vram(pid: int, smi: str) -> int | None:
    """MiB nvidia-smi reports for `pid`, from its compute-apps CSV (noheader, nounits)."""
    for line in smi.splitlines():
        cols = [c.strip() for c in line.split(",")]
        if len(cols) == 3 and cols[0] == str(pid) and cols[2].isdigit():
            return int(cols[2])
    return None


def judge_footprint(live: int | None, cand: int | None, tolerance: int) -> tuple[bool, str]:
    """Pass when the candidate needs no more than `tolerance` MiB over the live build."""
    if live is None:
        return False, ("the live build did not load at the pinned split, so nothing was "
                       "compared (check free VRAM and the service)")
    if cand is None:
        return False, f"the candidate did not load at the pinned split (live build: {live} MiB)"
    delta = cand - live
    verdict = f"live {live} MiB, candidate {cand} MiB ({delta:+d})"
    if delta <= tolerance:
        return True, verdict
    return False, f"{verdict}: more than {tolerance} MiB extra eats the 2 GB margin"


def service_busy(url: str) -> list[str]:
    """Models the live service has in VRAM right now. A stopped service is idle."""
    try:
        with urllib.request.urlopen(f"{url}/models", timeout=5) as resp:
            data = json.loads(resp.read().decode("utf-8")).get("data", [])
    except (urllib.error.URLError, OSError, ValueError):
        return []
    return [m["id"] for m in data
            if (m.get("status") or {}).get("value") in ("loaded", "loading")]


# --- runtime ------------------------------------------------------------------

def port_free(port: int) -> bool:
    with socket.socket() as s:
        return s.connect_ex(("127.0.0.1", port)) != 0


def free_port(start: int = 8090, stop: int = 8130) -> int:
    for p in range(start, stop):
        if port_free(p):
            return p
    raise SystemExit("no free port between 8090 and 8130 for the fit probe")


def xid_count() -> int:
    out = subprocess.run(["journalctl", "-k", "-b", "--no-pager"],
                         capture_output=True, text=True).stdout
    return sum(1 for line in out.splitlines() if "Xid" in line)


def stop(proc: subprocess.Popen) -> None:
    if proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=20)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()


def measure(binary: str, name: str, settings: dict[str, str], out: Path,
            tag: str) -> tuple[int | None, str]:
    """Load one model with `binary` at its pinned split and read its VRAM."""
    log_path = out / f"footprint-{name}-{tag}.log"
    with open(log_path, "w", encoding="utf-8") as log:
        proc = subprocess.Popen(footprint_cmd(binary, settings, free_port()),
                                stdout=log, stderr=subprocess.STDOUT)
    try:
        deadline = time.monotonic() + LOAD_TIMEOUT_S
        while time.monotonic() < deadline:
            if "model loaded" in log_path.read_text(encoding="utf-8", errors="replace"):
                break
            if proc.poll() is not None:
                return None, f"exited {proc.returncode} before loading (log: {log_path})"
            time.sleep(1)
        else:
            return None, f"not loaded within {LOAD_TIMEOUT_S} s (log: {log_path})"
        time.sleep(2)  # let the first compute buffers settle before reading
        smi = subprocess.run(["nvidia-smi", "--query-compute-apps=pid,process_name,used_memory",
                              "--format=csv,noheader,nounits"],
                             capture_output=True, text=True).stdout
        mib = process_vram(proc.pid, smi)
        return mib, "" if mib is not None else f"nvidia-smi did not list pid {proc.pid}"
    finally:
        stop(proc)


def smoke(binary: str, preset: Path, models: list[str], port: int, out: Path) -> tuple[bool, str]:
    router_log = out / "router.log"
    with open(router_log, "w", encoding="utf-8") as log:
        router = subprocess.Popen([binary, "--models-preset", str(preset), "--models-max", "1",
                                   "--port", str(port)], stdout=log, stderr=subprocess.STDOUT)
    try:
        url = f"http://localhost:{port}"
        deadline = time.monotonic() + ROUTER_TIMEOUT_S
        while time.monotonic() < deadline:
            try:
                with urllib.request.urlopen(f"{url}/health", timeout=2):
                    break
            except (urllib.error.URLError, OSError):
                if router.poll() is not None:
                    return False, f"router exited with {router.returncode} (log: {router_log})"
                time.sleep(1)
        else:
            return False, f"router not healthy within {ROUTER_TIMEOUT_S} s (log: {router_log})"
        env = dict(os.environ, LLM_URL=url)
        profile_log = out / "smoke.log"
        with open(profile_log, "w", encoding="utf-8") as log:
            rc = subprocess.run([sys.executable, str(REPO / "eval" / "run-profile.py"), "smoke",
                                 "--models", *models, "--out-root", str(out / "runs")],
                                stdout=log, stderr=subprocess.STDOUT, env=env).returncode
        if rc != 0:
            return False, f"smoke profile exited {rc} (log: {profile_log})"
        summaries = list((out / "runs").rglob("summary.md"))
        return True, f"smoke profile passed, {len(summaries)} summaries in {out / 'runs'}"
    finally:
        stop(router)


def version_of(binary: str) -> str:
    if not os.access(binary, os.X_OK):
        raise SystemExit(f"ERROR: {binary} is not an executable llama-server")
    ver = subprocess.run([binary, "--version"], capture_output=True, text=True)
    line = next((ln for ln in (ver.stdout + ver.stderr).splitlines()
                 if ln.startswith("version:")), "")
    if not line:
        raise SystemExit(f"ERROR: {binary} --version reported no version line")
    return line


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("binary", nargs="?", default=str(DEFAULT_BIN))
    ap.add_argument("--live", default=str(DEFAULT_LIVE),
                    help="the build to compare against (default: the live build folder)")
    ap.add_argument("--preset", type=Path, default=REPO / "models" / "models.ini")
    ap.add_argument("--out-root", type=Path, default=None,
                    help="where logs and smoke results go (default: a new temp folder)")
    ap.add_argument("--service-url", default="http://localhost:8080")
    ap.add_argument("--port", type=int, default=8081, help="port for the scratch router")
    ap.add_argument("--skip-smoke", action="store_true", help="run only the footprint check")
    args = ap.parse_args()

    binary = str(Path(args.binary).expanduser())
    live = str(Path(args.live).expanduser())
    version, live_version = version_of(binary), version_of(live)
    busy = service_busy(args.service_url)
    if busy:
        raise SystemExit(f"ERROR: the live service at {args.service_url} has {', '.join(busy)} "
                         f"in VRAM. The probes size the split from free VRAM, so wait until it "
                         f"is idle or stopped.")
    if not args.skip_smoke and not port_free(args.port):
        raise SystemExit(f"ERROR: port {args.port} is in use; pass --port")
    models = read_preset(args.preset)
    if not models:
        raise SystemExit(f"ERROR: no models in {args.preset}; run make build")
    out = (args.out_root or Path(tempfile.mkdtemp(prefix="verify-build-"))).resolve()
    out.mkdir(parents=True, exist_ok=True)

    print(f"Candidate: {version}\n  {binary}\nLive:      {live_version}\n  {live}\n"
          f"Preset:    {args.preset}\nLogs:      {out}\n")
    xid_before = xid_count()
    rows: list[tuple[str, bool, str]] = []
    for name, settings in models.items():
        print(f"  {name}: loading on the live build, then the candidate ...", flush=True)
        live_mib, live_err = measure(live, name, settings, out, "live")
        cand_mib, cand_err = measure(binary, name, settings, out, "candidate")
        ok, why = judge_footprint(live_mib, cand_mib, TOLERANCE_MIB)
        detail = "; ".join(e for e in (live_err, cand_err) if e)
        rows.append((f"VRAM {name}", ok, f"{why}{' [' + detail + ']' if detail else ''}"))
    if not args.skip_smoke:
        print("  smoke profile on a scratch router ...", flush=True)
        ok, why = smoke(binary, args.preset, list(models), args.port, out)
        rows.append(("smoke", ok, why))
    new_xid = xid_count() - xid_before
    rows.append(("GPU faults", new_xid == 0,
                 "no new Xid" if new_xid == 0 else f"{new_xid} new Xid line(s): journalctl -k -b | grep -i xid"))

    print()
    for check, ok, why in rows:
        print(f"  {'PASS' if ok else 'FAIL'}  {check:<14} {why}")
    passed = all(ok for _, ok, _ in rows)
    print(f"\n{'PASS' if passed else 'FAIL'}: {version}")
    if passed:
        print("Next: scripts/llama-update swap, then restart the service.")
    return 0 if passed else 1


if __name__ == "__main__":
    sys.exit(main())
