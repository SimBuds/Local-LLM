#!/usr/bin/env bash
set -euo pipefail

MODEL_NAME="nemotron"
# Added 2026-11-19 by ./add-model.
BASE_MODEL="NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q4_K_M.gguf"

# Per-model load params. The shared sampler baseline lives in server.ini [*],
# identical for every model, so PARAMS is deliberately absent here.
# This GGUF carries MTP heads (nextn_predict_layers), so speculative decoding
# is on. Keep spec-type when re-deriving n-cpu-moe: the MTP layer needs VRAM
# of its own, and fitting without it gives a split that is too generous.
#
# Fitter's split from --fit-target 2048 on 2026-11-19 (n-cpu-moe = 48), with
# 1525 MiB held by other processes at probe time.
# Fit line: CUDA0 (NVIDIA GeForce RTX 3080): 54 layers (48 overflowing),   5973 MiB used,   2170 MiB free
# server.ini pins fit = off, so this is the split every load uses. Re-derive it
# with ./add-model --refit nemotron after a model or hardware change. Do not
# turn automatic fitting back on: it would resize the split from whatever
# VRAM happens to be free per run.
# Speed at probe time: 23.9 tok/s generation, thinking off (floor 20).
#
# Pinned at 52, not the fitter's 48 (Casey, 2026-11-19). At 48 the spike test
# failed 0 of 5: with about 3 GB of the card held elsewhere the model loaded and
# the MTP draft context could not allocate its 309 MiB compute buffer. The fitter
# does not leave room for it on this model. At 52 the spike test passes 5 of 5
# with about 2.3 GB free at peak, and generation measured 24 to 28 tok/s, no
# slower than at 48 or 50. Details in TESTING.md, *nemotron added*.
#
# Moved from 52 to 50 on 2026-11-19 (Casey). RAM is the tight resource with this
# model loaded, about 4 GB available at 52, and 50 puts about 1.1 GB more of it
# on the card. 50 passed the spike test 5 of 5 with about 1.2 GB free at peak,
# the same margin gemma and qwen run with. Speed did not differ between 50 and
# 52. 48 is not an option: the MTP draft context cannot allocate there.
LOAD=(
  'n-cpu-moe = 50'
  'spec-type = draft-mtp'
)

# Shared assembly, see build-common.sh.
source "$(dirname "${BASH_SOURCE[0]}")/build-common.sh"
