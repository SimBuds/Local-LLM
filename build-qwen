#!/usr/bin/env bash
set -euo pipefail

MODEL_NAME="qwen"
# Official Qwen3.6 MoE release. Briefly retargeted (2026-07-27) at an uncensored
# community tune; reverted 2026-07-28 because that tune works against
# prompts/safety.md by construction — the stack spends tokens every turn fighting
# the model's own tuning. An uncensored base needs its own tag and its own prompt
# stack, not a swap under the shared one.
# Reused from Ollama's qwen3.6:35b-a3b-mtp-q4_K_M blob — same weights as the
# Ollama-era benchmarks. It carries llama.cpp-compatible MTP (nextn) tensors.
BASE_MODEL="qwen3.6-35b-a3b-mtp-q4_K_M.gguf"

# Context: 262144 - 131072 - 65536 - 32768 - 16384 - 8192 - 4096

# Shared baseline params — deliberately IDENTICAL to build-gemma. See the note
# there: differing samplers across builders confound the head-to-head.
PARAMS=(
  'ctx-size = 32768'         # 32k: sweet spot for multi-file local tasks; matches run-json.py's pin
  'temp = 0.2'               # Low temperature forces strict compliance with code syntax and tool tags
  'top-p = 0.95'
  'top-k = 40'
  'min-p = 0.05'             # Safeguards structural format without restricting code vocabulary
  'presence-penalty = 0.0'   # MUST BE ZERO. Coding requires reusing exact variable names.
  'repeat-penalty = 1.05'    # Prevents infinite code loops without breaking boilerplate code
)

# Per-model load params. Expert split pinned for the reason given in build-gemma;
# 32 is what --fit chose on 2026-09-14 (42 layers, 32 overflowing, 7226 MiB).
# MTP measured 2026-09-14: 60.7 tok/s thinking off, ~65% draft acceptance.
LOAD=(
  'n-cpu-moe = 32'
  'spec-type = draft-mtp'
)

# Shared assembly — see build-common.sh.
source "$(dirname "${BASH_SOURCE[0]}")/build-common.sh"
